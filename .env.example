# Local SQLite is the easiest way to start.
DATABASE_URL=sqlite:///hrms.db
HRMS_SECRET_KEY=replace-with-a-long-random-secret
HRMS_ADMIN_PASSWORD=replace-with-a-strong-password
FLASK_DEBUG=1

# To use MySQL instead, create a database named hrms and use:
# DATABASE_URL=mysql+pymysql://hrms_user:your_password@localhost/hrms
